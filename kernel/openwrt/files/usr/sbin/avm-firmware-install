#!/bin/sh
# Installs the firmware of the packet processors, without which lan0 can't start,
# from AVM's public firmware 06.88 for the FRITZ!Box 7390 in /lib/firmware, where
# it survives a sysupgrade (/lib/upgrade/keep.d). Then it removes the setup
# network that /etc/board.d/02_network brought up because the firmware was
# missing, and restarts the network. /usr/libexec/avm-firmware/extract takes the
# files out of AVM's image.
#
# With --usb it also installs the FPGA bitstream, which powers the USB port, and
# loads it; /etc/init.d/fpga loads it at every start. Once loaded, the FPGA also
# lights a red LED inside the box, so leave it out if you don't use USB.
#
# Usage: avm-firmware-install [--usb] < FRITZ.Box_Fon_WLAN_7390-06.88.image
# From another machine: ssh root@<box> avm-firmware-install < FRITZ.Box_Fon_WLAN_7390-06.88.image
set -eu -o pipefail
. /lib/functions/fritzbox7390-setup.sh

FIRMWARE_DIR=/lib/firmware
WORK=/tmp/avm-firmware
USAGE="Usage: avm-firmware-install [--usb] < FRITZ.Box_Fon_WLAN_7390-06.88.image"

with_usb=
case "${1:-}" in
    --usb) with_usb=1 ;;
    "") ;;
    *) echo "$USAGE" >&2; exit 2 ;;
esac
if [ -t 0 ]; then
    echo "$USAGE" >&2
    exit 2
fi

# Copies a file to /lib/firmware unless it is there already. Returns 1 if it was.
# It is called in "&&", where set -e doesn't stop at a failure, so it exits itself.
# Usage: install_firmware <name in WORK and in FIRMWARE_DIR>
install_firmware() {
    if cmp -s "$WORK/$1" "$FIRMWARE_DIR/$1"; then
        return 1
    fi
    if ! cp "$WORK/$1" "$FIRMWARE_DIR/$1" || ! chmod 600 "$FIRMWARE_DIR/$1"; then
        echo "Cannot install $1 in $FIRMWARE_DIR" >&2
        exit 1
    fi
    echo "Installed $1 in $FIRMWARE_DIR"
}

rm -rf -- /tmp/avm-firmware
trap 'rm -rf -- /tmp/avm-firmware' EXIT
/usr/libexec/avm-firmware/extract "$WORK"

lan_changed=
install_firmware fusiv-bmu.bin && lan_changed=1
install_firmware fusiv-eth.bin && lan_changed=1
fpga_changed=
if [ -n "$with_usb" ]; then
    install_firmware fpga.bit && fpga_changed=1
fi
sync

if [ -n "$fpga_changed" ]; then
    echo "Loading the FPGA"
    /usr/sbin/load-fpga
elif [ -n "$with_usb" ]; then
    echo "The FPGA bitstream was installed already"
fi

if [ -z "$lan_changed" ]; then
    echo "The LAN firmware was installed already"
    exit 0
fi

setup_networks=$(uci show wireless | sed -n "s/^wireless\.\([^.]*\)\.ssid='$SETUP_SSID_PREFIX.*'\$/\1/p")
for network in $setup_networks; do
    echo "Removing the setup network $(uci get "wireless.$network.ssid")"
    uci delete "wireless.$network"
done
uci commit wireless

echo "Restarting the network"
/etc/init.d/network restart
