+/*
+ * An 8 bit chip on the low byte lines of a 16 bit bus, as on the AVM
+ * FRITZ!Box 7390, only sees 16 bit accesses.
+ */
+static void gpio_nand_write_byte(struct gpiomtd *gpiomtd, u8 value)
+{
+	if (gpiomtd->bus_16bit)
+		writew(value, gpiomtd->io);
+	else
+		writeb(value, gpiomtd->io);
+}
+
+static u8 gpio_nand_read_byte(struct gpiomtd *gpiomtd)
+{
+	if (gpiomtd->bus_16bit)
+		return readw(gpiomtd->io);
+	return readb(gpiomtd->io);
+}
