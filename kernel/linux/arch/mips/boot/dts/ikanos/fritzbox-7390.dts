// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "avm,fritzbox-7390", "ikanos,vx180";
	model = "AVM FRITZ!Box Fon WLAN 7390";

	aliases {
		serial0 = &uart2;
		led-boot = &led_power;
		led-failsafe = &led_power_red;
		led-running = &led_power;
		led-upgrade = &led_power_red;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* The numbers are those of AVM's hw156 configuration minus 16. */
	leds {
		compatible = "gpio-leds";

		led_power: led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
			default-state = "keep";
		};

		led_power_red: led-1 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;
		};

		led-2 {
			color = <LED_COLOR_ID_GREEN>;
			function = "internet";
			gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
		};

		/* Labelled "Festnetz" on the box. */
		led-3 {
			color = <LED_COLOR_ID_GREEN>;
			function = "phone";
			gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
		};

		led-4 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
		};

		led-5 {
			color = <LED_COLOR_ID_GREEN>;
			function = "info";
			gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
		};

		led-6 {
			color = <LED_COLOR_ID_RED>;
			function = "info";
			gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
		};
	};

	cpuintc: interrupt-controller {
		compatible = "mti,cpu-interrupt-controller";
		#address-cells = <0>;
		#interrupt-cells = <1>;
		interrupt-controller;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		ipc: interrupt-controller@19050000 {
			compatible = "ikanos,vx180-ipc";
			reg = <0x19050000 0x400>;
			#interrupt-cells = <1>;
			interrupt-controller;
			interrupt-parent = <&cpuintc>;
			interrupts = <2>;
		};

		/*
		 * GPIOs 16 to 31. GPIOs 0 to 15 stay without a driver, because /init
		 * drives the FPGA and the switch reset there through /dev/mem.
		 */
		gpio1: gpio@190b0000 {
			compatible = "ikanos,vx180-gpio";
			reg = <0x190b0000 0x8>;
			gpio-controller;
			#gpio-cells = <2>;
		};

		uart2: serial@190a0000 {
			compatible = "ns16450";
			reg = <0x190a0000 0x20>;
			reg-shift = <2>;
			clock-frequency = <166666666>;
			no-loopback-test;
			interrupt-parent = <&ipc>;
			interrupts = <29>;
		};

		ethernet@19110000 {
			compatible = "ikanos,fusiv-eth";
			reg = <0x19110000 0x1000>;
			interrupt-parent = <&ipc>;
			interrupts = <14>;
		};

		usb@19230000 {
			compatible = "generic-ehci";
			reg = <0x19230000 0x5c>;
			interrupt-parent = <&ipc>;
			interrupts = <35>;
		};

		usb@19240800 {
			compatible = "generic-ohci";
			reg = <0x19240800 0x5c>;
			interrupt-parent = <&ipc>;
			interrupts = <35>;
		};

		/*
		 * An AMD style CFI chip, as in AVM's kernel (CONFIG_MTD_CFI_AMDSTD, 16 bit).
		 * Only rootfs_data and firmware (for sysupgrade) are writable. urlader is
		 * read only and tffs is not listed, so Linux never erases or programs them.
		 * The urlader partition also holds secrets in its environment, so its
		 * content must stay out of logs. Only the calibration cells are used.
		 */
		flash@1f000000 {
			compatible = "cfi-flash";
			reg = <0x1f000000 0x1000000>;
			bank-width = <2>;

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				partition@0 {
					compatible = "nvmem-cells";
					label = "urlader";
					reg = <0x0 0x20000>;
					read-only;
					#address-cells = <1>;
					#size-cells = <1>;

					calibration_5ghz: calibration@985 {
						reg = <0x985 0x1000>;
					};

					calibration_2ghz: calibration@198a {
						reg = <0x198a 0x1000>;
					};
				};

				/*
				 * Where EVA starts the firmware, see build.sh: the EVA image of
				 * the kernel with a dummy squashfs, padded to 4 MB, then OpenWrt's
				 * squashfs. While the AVM firmware is installed, its own kernel and
				 * root file system lie here instead. tffs follows at 0xf00000 and
				 * is not listed.
				 */
				partition@20000 {
					label = "kernel";
					reg = <0x20000 0x400000>;
					read-only;
				};

				partition@420000 {
					label = "rootfs";
					reg = <0x420000 0x600000>;
					read-only;
				};

				/*
				 * The only writable partition: OpenWrt's settings and installed
				 * packages (jffs2, set up by mount_root). It ends where tffs begins.
				 */
				partition@a20000 {
					label = "rootfs_data";
					reg = <0xa20000 0x4e0000>;
				};

				/*
				 * The three partitions above as one, for sysupgrade
				 * (openwrt/files/lib/upgrade/platform.sh). The only other
				 * writable one.
				 */
				partition@20000-firmware {
					label = "firmware";
					reg = <0x20000 0xee0000>;
				};
			};
		};

		/*
		 * The 512 MB NAND (Micron MT29F4G08ABADA) without a NAND controller, as
		 * in AVM's direct_avm.c with CONFIG_MTD_NAND_DIRECT_AVM_GPIO: data through
		 * the bus at 0x1e000000, the control lines on GPIOs 16 (/CE), 18 (CLE),
		 * 19 (ALE) and 20 (/WP). The 8 bit chip sits on the low byte of a 16
		 * bit bus, so it only answers 16 bit accesses (patch 0012). The ready
		 * line (GPIO 21) is left out: writes to the bus are posted, so it still
		 * reads ready before a command has reached the chip. Linux asks the
		 * chip for its status over the bus instead, which keeps the order.
		 * GPIO writes and bus accesses can still overtake each other, so the
		 * driver reads the NOR flash on the same bus around each change of the
		 * lines, as AVM's driver does (io-sync-reg, patch 0012). AVM switches
		 * on the chip's own ECC, so it is used here too. After power-on the
		 * chip often doesn't answer until it was reset a few times, as AVM's
		 * driver notes and does before its scan (reset-at-probe, patch 0012).
		 */
		nand@1e000000 {
			compatible = "gpio-control-nand";
			reg = <0x1e000000 0x2>;
			gpio-control-nand,16bit-bus;
			gpio-control-nand,reset-at-probe;
			gpio-control-nand,io-sync-reg = /bits/ 64 <0x1f000000>;
			nce-gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;
			ale-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
			cle-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
			nwp-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
			nand-ecc-mode = "on-die";

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				/*
				 * UBI attaches it at boot. It refuses a partition with
				 * other content, such as AVM's, until ubiformat has
				 * prepared it. The volume must not be called rootfs_data,
				 * or OpenWrt's mount_root takes it as its overlay instead
				 * of the NOR flash.
				 */
				partition@0 {
					compatible = "linux,ubi";
					label = "ubi";
					reg = <0x0 0x20000000>;
				};
			};
		};

		pci: pci@19170000 {
			compatible = "ikanos,vx180-pci";
			device_type = "pci";
			reg = <0x19170000 0x100>;
			#address-cells = <3>;
			#size-cells = <2>;
			#interrupt-cells = <1>;
			bus-range = <0x00 0x00>;
			ranges = <0x02000000 0 0x1a000000 0x1a000000 0 0x01000000>;

			wifi@1,0 {
				reg = <0x0800 0 0 0 0>;
				nvmem-cells = <&calibration_5ghz>;
				nvmem-cell-names = "calibration";
			};

			wifi@2,0 {
				reg = <0x1000 0 0 0 0>;
				nvmem-cells = <&calibration_2ghz>;
				nvmem-cell-names = "calibration";
			};
		};
	};
};
